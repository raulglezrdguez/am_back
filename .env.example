NODE_ENV=development
PORT=5050

# La app escribe aquí. Debe coincidir con MONGO_APP_DB de los scripts.
MONGO_URI=mongodb://localhost:27017/am_back?replicaSet=rs0
MONGO_APP_DB=am_back

JWT_SECRET=change-me-with-at-least-32-characters
REDIS_URL=redis://localhost:6379

# Opcional: si está vacío, Firebase no se inicializa y la auth local (JWT)
# sigue funcionando. La readiness lo reporta como "down" (no crítico).
FIREBASE_SERVICE_ACCOUNT=

# Logging / lifecycle
APP_VERSION=dev
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=15000
HEALTHCHECK_TIMEOUT_MS=2000
FIREBASE_CHECK_TTL_MS=30000
LOG_LEVEL=info
LOG_ERROR_STACK=0

# Métricas
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
METRICS_TOKEN=

# Auditoría
AUDIT_ENABLED=true
AUDIT_FAIL_CLOSED=true
AUDIT_RETENTION_DAYS=2190
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_WRITE_CONCERN=majority
AUDIT_LEGAL_HOLD=false
# --- Operación (scripts) ---------------------------------------------------
# IMPORTANTE: npm NO carga este fichero. Antes de `npm run audit:*`:
#   set -a; source .env; set +a
# Los usuarios se crean en admin: la URI necesita authSource=admin.
MONGO_ADMIN_URI=
MONGO_ARCHIVER_URI=

MONGO_APP_USER=am_app
MONGO_AUDIT_USER=am_audit_writer
MONGO_AUDIT_READER_USER=am_audit_reader
MONGO_ARCHIVER_USER=am_archiver

MONGO_APP_PASSWORD=
MONGO_AUDIT_PASSWORD=
MONGO_AUDIT_READER_PASSWORD=
MONGO_ARCHIVER_PASSWORD=

AUDIT_ARCHIVE_BATCH_SIZE=5000
AUDIT_ARCHIVE_MAX_BATCHES=1000
AUDIT_MIGRATION_BATCH_SIZE=5000
AUDIT_MIGRATION_MAX_BATCHES=100000

# Escape de transición: permite seguir usando la DB de la app en producción.
# Déjalo en false
AUDIT_ALLOW_SHARED_DB=false

# Ejemplo de URI dedicada (usuario insert-only, authSource=admin):
# MONGO_AUDIT_URI=mongodb://am_audit_writer:<password>@mongo:27017/am_audit?replicaSet=rs0&authSource=admin


# DB/rol dedicado de auditoría (obligatorio en producción).
# Formato: mongodb://am_audit_writer:<password>@mongo:27017/am_audit?replicaSet=rs0
MONGO_AUDIT_URI=
MONGO_AUDIT_DB=am_audit
AUDIT_ARCHIVE_DB=am_archive

# Tracing / errors. Vacíos = desactivados en local.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=am-back
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
