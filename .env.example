NODE_ENV=development
PORT=5050
MONGO_URI=mongodb://localhost:27017/am
JWT_SECRET=change-me-with-at-least-32-characters
FIREBASE_SERVICE_ACCOUNT=base64-service-account-json
REDIS_URL=redis://localhost:6379

# Logging / lifecycle
APP_VERSION=dev
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=15000
HEALTHCHECK_TIMEOUT_MS=2000
FIREBASE_CHECK_TTL_MS=30000
LOG_LEVEL=info
METRICS_HOST=127.0.0.1
AUDIT_HOT_RETENTION_DAYS=90
MONGO_AUDIT_URI=
MONGO_AUDIT_DB=am_audit
AUDIT_ARCHIVE_DB=am_archive

# Audit
AUDIT_ENABLED=true
AUDIT_FAIL_CLOSED=true
AUDIT_RETENTION_DAYS=2190

# Metrics
METRICS_PORT=9464
METRICS_TOKEN=

# Tracing / errors
OTEL_ENABLED=true
OTEL_SERVICE_NAME=am-back
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
