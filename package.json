{
  "name": "back",
  "version": "1.0.0",
  "description": "backend graphql & restful server",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/index.js",
    "dev": "tsx watch index.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit --runInBand --detectOpenHandles",
    "test:int": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand --coverage --detectOpenHandles --forceExit",
    "audit:indexes": "mongosh \"$MONGO_ADMIN_URI\" scripts/audit-log-collection.js",
    "audit:migrate": "mongosh \"$MONGO_ADMIN_URI\" scripts/migrate-audit-db.js",
    "audit:archive": "mongosh \"$MONGO_ARCHIVER_URI\" scripts/archive-audit-logs.js",
    "audit:purge": "mongosh \"$MONGO_ARCHIVER_URI\" scripts/purge-audit-archive.js",
    "audit:roles": "mongosh \"$MONGO_ADMIN_URI\" scripts/mongo-audit-roles.js",
    "check:scripts": "node --check scripts/archive-audit-logs.js && node --check scripts/audit-log-collection.js && node --check scripts/mongo-audit-roles.js && node --check scripts/migrate-audit-db.js && node --check scripts/purge-audit-archive.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/merge": "^9.1.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@sentry/node": "11.12.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^13.5.0",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "pino": "^10.1.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
