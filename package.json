{
  "name": "back",
  "version": "1.0.0",
  "description": "backend graphql & restful server",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch index.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit --runInBand --detectOpenHandles",
    "test:int": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand --coverage --detectOpenHandles --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^13.5.0",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "pino": "^10.1.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
